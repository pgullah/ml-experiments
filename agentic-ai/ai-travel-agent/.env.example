OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=openrouter/free
OPENWEATHERMAP_API_KEY=replace-with-openweathermap-key

# Optional search providers; DuckDuckGo is always the final fallback.
SERPER_API_KEY=
TAVILY_API_KEY=

# Optional prompt-router provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Operational limits.
DOMAIN_CONFIDENCE_THRESHOLD=0.8
MAX_REQUEST_CHARACTERS=4000
MAX_CONTEXT_MESSAGES=5
MAX_CONTEXT_CHARACTERS=4000
MAX_GUARD_THREADS=1000
MAX_CONVERSATION_MESSAGES=40
GRAPH_RECURSION_LIMIT=25
SEARCH_MAX_RESULTS=5
SEARCH_MAX_OUTPUT_CHARACTERS=12000
REQUEST_TIMEOUT_SECONDS=10
